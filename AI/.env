# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60
MAX_TOKENS=4000

# MongoDB Configuration (Optional - falls back to file storage)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_course_pro

# Application Settings
APP_NAME=AI Course Pro
DEBUG=false
LOG_LEVEL=INFO

# Performance Settings
CACHE_ENABLED=true
MAX_CACHE_SIZE=1000
